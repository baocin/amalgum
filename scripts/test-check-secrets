#!/usr/bin/env bash
# Exercise scripts/check-secrets against a scratch repo: its exit code gates commits and CI
# (scripts/agent/verify, .github/workflows/ci.yml's secrets-history job), so it must fail
# closed — a broken revision range or a real hit must never come back as exit 0.
set -uo pipefail
repo_root="$(git rev-parse --show-toplevel)" || exit 1
check="$repo_root/scripts/check-secrets"
pass=0; failed=0

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git -C "$tmp" init -q -b main
git -C "$tmp" config user.email test@example.com
git -C "$tmp" config user.name test
printf 'hello\n' > "$tmp/a.txt"
git -C "$tmp" -c commit.gpgsign=false add a.txt
git -C "$tmp" -c commit.gpgsign=false commit -q -m "initial"

expect() { # <description> <want-exit-status> [args to check-secrets…]
  local desc="$1" want="$2"; shift 2
  (cd "$tmp" && "$check" "$@") >/dev/null 2>&1
  local got=$?
  if [ "$got" = "$want" ]; then pass=$((pass + 1)); else failed=$((failed + 1)); echo "✗ $desc: expected exit $want, got $got"; fi
}

# History mode must fail closed on a range git itself cannot read (no origin/main here, a
# missing branch, or a typo) — it must never read as "clean" because nothing was scanned.
expect "invalid revision range fails closed" 2 origin/main..HEAD
expect "nonexistent revision range fails closed" 2 nonexistent..HEAD
# A range that resolves but touches nothing is genuinely clean.
expect "empty-but-valid range is clean" 0 HEAD..HEAD

# Working tree: clean repo passes.
expect "clean working tree passes" 0
# A credential-shaped string in an untracked file fails (git grep --untracked covers it).
printf 'AKIAABCDEFGHIJKLMNOP\n' > "$tmp/b.txt"
expect "credential in the working tree fails" 1
rm -f "$tmp/b.txt"

# History mode still finds a secret introduced and later removed in a real range.
printf 'AKIAABCDEFGHIJKLMNOP\n' > "$tmp/c.txt"
git -C "$tmp" -c commit.gpgsign=false add c.txt
git -C "$tmp" -c commit.gpgsign=false commit -q -m "oops: add key"
rm -f "$tmp/c.txt"
git -C "$tmp" -c commit.gpgsign=false add -A
git -C "$tmp" -c commit.gpgsign=false commit -q -m "remove key"
first="$(git -C "$tmp" rev-list --max-parents=0 HEAD)"
expect "secret in history is still found after it is removed" 1 "$first..HEAD"

echo "check-secrets tests: $pass passed, $failed failed"
[ "$failed" = 0 ]
