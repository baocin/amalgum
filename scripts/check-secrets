#!/usr/bin/env bash
# Fail if a credential-shaped string is present.
#   scripts/check-secrets                 tracked + untracked (non-ignored) files
#   scripts/check-secrets <rev-range>     every patch in the range (a secret deleted later is still in history)
# A pattern match, not a guarantee: it catches the realistic accident, not an adversary.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
PATTERNS='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'

if [ $# -gt 0 ]; then
  if ! log="$(git log -p --format='commit %H' "$1" -- . ':!scripts/check-secrets' ':!scripts/test-hooks' ':!scripts/test-check-secrets')"; then
    echo "check-secrets: cannot read range $1" >&2
    exit 2
  fi
  hits="$(printf '%s\n' "$log" | grep -nE -e "$PATTERNS")"
  [ -z "$hits" ] && exit 0
  printf '%s\n' "$hits" >&2; echo "check-secrets: credential-like string in history of $1" >&2; exit 1
fi

git grep --untracked -nIE -e "$PATTERNS" -- . ':!scripts/check-secrets' ':!scripts/test-hooks' ':!scripts/test-check-secrets'
case $? in
  0) echo "check-secrets: credential-like string found (above)" >&2; exit 1 ;;
  1) exit 0 ;;
  *) echo "check-secrets: git grep failed" >&2; exit 2 ;;
esac
