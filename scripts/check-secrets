#!/usr/bin/env bash
# Fail if a credential-shaped string is in any tracked or untracked (non-ignored) file.
# A pattern match, not a guarantee: it catches the realistic accident, not an adversary.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
PATTERNS='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'
git grep --untracked -nIE -e "$PATTERNS" -- . ':!scripts/check-secrets' ':!scripts/test-hooks'
case $? in
  0) echo "check-secrets: credential-like string found (above)" >&2; exit 1 ;;
  1) exit 0 ;;
  *) echo "check-secrets: git grep failed" >&2; exit 2 ;;
esac
