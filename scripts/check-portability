#!/usr/bin/env bash
# Enforce docs/SPEC.md §1 "Portability rules" and the headless/UI boundary.
# Escape hatch for a reviewed exception: end the line with `// portability: allow`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
check() { # <message> <grep -E pattern> <pathspec…>
  local msg="$1" pat="$2"; shift 2
  local hits rc
  hits="$(git grep --untracked -nE -e "$pat" -- "$@")"; rc=$?
  if [ "$rc" -gt 1 ]; then echo "✗ check-portability: git grep failed for: $msg" >&2; status=2; return; fi
  hits="$(printf '%s' "$hits" | grep -v 'portability: allow')"
  if [ -n "$hits" ]; then printf '%s\n%s\n\n' "✗ $msg" "$hits" >&2; status=1; fi
}

check "OS-specific cfg outside src/platform/ — move it behind a platform:: function" \
  'target_os|target_vendor *= *"apple"' 'src/*.rs' ':!src/platform/*'
check "OS tool invoked outside src/platform/ — call the platform:: function instead" \
  'Command::new\("(open|xdg-open|osascript|lsof|ss|notify-send|dbus-send|launchctl|defaults)"\)' \
  'src/*.rs' ':!src/platform/*'
check "Absolute path literal — derive it from paths::Dirs, \$HOME, or git config" \
  '"/(Users|home|usr|etc|opt|var|tmp|Library|Applications|private)/' 'src/*.rs' ':!src/platform/*'
check "egui/eframe/terminal crate used outside src/ui/ — the headless CLI must build without them" \
  '(^|[^_a-z])(egui|eframe|alacritty_terminal|arboard|sysinfo)::' 'src/*.rs' ':!src/ui/*'
check "cfg(feature = \"gui\") outside lib.rs/main.rs — put UI code under src/ui/ instead" \
  'feature *= *"gui"' 'src/*.rs' ':!src/lib.rs' ':!src/main.rs' ':!src/ui/*'
check "Color literal in UI code — use a model::theme token (SPEC §4: no literal hex in UI code)" \
  'Color32::from_(rgb|rgba|hex|gray)|#[0-9A-Fa-f]{6}\b' 'src/ui/*' ':!src/ui/theme.rs'

[ "$status" = 0 ] || echo "check-portability: see docs/SPEC.md §1 and .claude/skills/add-platform-code" >&2
exit "$status"
